rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Game rooms — open by design. There are no accounts: you join a room by saying a
    // four-letter word out loud to the people in the room with you. Rooms hold a
    // nickname, an emoji and a board position, and nothing else about anybody.
    //
    // Note this means the whole room document, including every player's hand, reaches
    // every device in the room. Card COUNTS are public in this game anyway and the
    // client never renders another player's actual cards, but a determined player with
    // devtools open could read them. Closing that properly needs a server holding the
    // hidden state (Cloud Functions on a paid plan); until then the honour system and
    // the fact that you are playing with friends is the protection.
    // Two shapes of room id. A typed room is a four-letter word people say out loud.
    // A Discord Activity room is keyed by the voice channel's instance id instead, so
    // everyone Discord launched the game for lands in the same game without typing
    // anything — those are prefixed 'D' and are longer.
    function validRoomId(code) {
      return (code.size() == 4 && code.matches('^[A-Z]+$'))
          || code.matches('^D[A-Za-z0-9_-]{4,120}$');
    }

    match /rooms/{code} {
      allow read: if true;
      allow create: if validRoomId(code)
                    && request.resource.data.keys().hasAll(['code', 'state', 'players'])
                    && request.resource.data.code == code;
      allow update: if true;
      allow delete: if true;
    }

    // Chat, one document per message, in a subcollection under the room.
    //
    // Under the room and not inside its document on purpose: the room document is the
    // entire game state and every move rewrites it to every phone in the room, so a chat
    // message living in there would re-send the board to say "gg".
    //
    // A subcollection is NOT covered by the rule on the room above — that matches the
    // document, not what is beneath it — so without this block the catch-all at the
    // bottom denies every read and write and the chat silently does nothing.
    //
    // The shape is enforced here; the words are not. Rules cannot hold a word list worth
    // having, and the list would be public anyway. The app filters what it sends and
    // masks everything it draws, which is what actually keeps a message off a screen.
    match /rooms/{code}/chat/{msg} {
      allow read: if validRoomId(code);
      allow create: if validRoomId(code)
                    && request.resource.data.keys().hasOnly(['by', 'name', 'text', 'at'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 140
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 14;
      // Said is said: a message cannot be edited into something else after the fact.
      allow update: if false;
      allow delete: if true;
    }

    // Connection heartbeat, one tiny document per room, kept OUT of the room itself.
    // Firestore has no field-level deltas: a beat written inside the room would
    // rebroadcast the entire game state to every phone every few seconds.
    match /pulses/{code} {
      allow read: if true;
      allow write: if validRoomId(code)
                   && request.resource.data.keys().hasOnly(['at', 'by', 'code', 'expiresAt']);
      allow delete: if true;
    }

    // The version the deploy last published. Every device watches this one document,
    // so a new build reaches open phones the moment it lands rather than whenever they
    // next happen to look. Written by the Pages workflow, never by the app.
    match /meta/{doc} {
      allow read: if true;
      allow write: if doc == 'version'
                   && request.resource.data.keys().hasOnly(['version', 'at'])
                   && request.resource.data.version is string
                   && request.resource.data.version.size() <= 32;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
